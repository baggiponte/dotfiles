{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.3-flash",
  "agents": {
    "plan": { "model": "opencode-go/glm-5.3-flash" },
    "build": { "model": "opencode-go/glm-5.3-flash" }
  },
  "websearch": {
    "provider": "random"
  },
  "skills": ["~/work/skills"],
  "mcp": {
    "servers": {
      "rex-community": {
        "type": "remote",
        "url": "https://www.superlogical.com/rex/community-mcp",
        "codemode": true
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "enabled": true,
        "oauth": {}
      }
    }
  }
}
