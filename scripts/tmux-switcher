#! /usr/bin/env zsh

show_help() {
    cat <<'EOF'
tmux-switcher: switch tmux sessions or create/switch from zoxide projects

If no tmux server is running, one is started and the script waits briefly
for tmux-continuum to auto-restore saved sessions before showing the picker.
Pair with "tmux-halt" to save the snapshot before killing the server.

Usage:
  tmux-switcher [--mode <sessions|projects>] [query...]

Keys:
  ctrl-n   toggle sessions/projects modes
  ctrl-x   kill selected session (sessions mode only)
EOF
}

# Ensure a tmux server is running before showing the picker.
# When the server is fresh (e.g. killed to reload tmux.conf), continuum
# auto-restores saved sessions ~1s after boot; wait (bounded) for the first
# session to appear so the picker is not empty. This is a readiness
# heuristic: it does not guarantee the restore has fully finished.
# Requires `exit-empty off` in tmux.conf: otherwise the server exits
# immediately with zero sessions and nothing can be restored into it.
ensure_server() {
    if tmux list-sessions >/dev/null 2>&1; then
        return 0
    fi

    # server already alive but sessionless: nothing will be restored
    if tmux info >/dev/null 2>&1; then
        return 0
    fi

    tmux start-server || return 1

    local deadline=$(( SECONDS + 5 ))
    while (( SECONDS < deadline )); do
        sleep 0.2
        tmux list-sessions >/dev/null 2>&1 && return 0
    done

    return 0
}

session_preview_cmd() {
    cat <<'EOF'
session={}

if ! tmux has-session -t "$session" 2>/dev/null; then
    printf "Session not found: %s\n" "$session"
    exit 0
fi

c_reset="$(printf "\033[0m")"
c_title="$(printf "\033[1;36m")"
c_label="$(printf "\033[1;33m")"
c_path="$(printf "\033[0;34m")"

printf "%sSession:%s %s\n" "$c_title" "$c_reset" "$session"
echo

# fields are separated with \037 (unit separator), not "|": tmux window and
# pane names are arbitrary text and may contain pipes; the last field keeps
# any extra separators via read's remainder behavior
sep="$(printf '\037')"

tmux list-windows -t "$session" \
    -F "#{window_index}${sep}#{window_panes}${sep}#{window_name}" 2>/dev/null |
while IFS="$sep" read -r window_index window_panes window_name; do
    window_i=$((window_i + 1))

    if [ "$window_panes" = "1" ]; then
        pane_word="pane"
    else
        pane_word="panes"
    fi

    printf "├── %sWindow %s%s: %s (%s %s)\n" \
        "$c_label" "$window_index" "$c_reset" "$window_name" "$window_panes" "$pane_word"

    tmux list-panes -t "${session}:${window_index}" \
        -F "#{pane_index}${sep}#{pane_current_command}${sep}#{pane_current_path}" 2>/dev/null |
    while IFS="$sep" read -r pane_index pane_command pane_path; do

        short_path="$(printf "%s" "$pane_path" | sed "s#^${HOME}#~#")"

        printf "│   ├── %sPane %s.%s%s: cmd=%s%s%s path=%s%s%s\n" \
            "$c_label" "$window_index" "$pane_index" "$c_reset" \
            "$c_title" "$pane_command" "$c_reset" \
            "$c_path" "$short_path" "$c_reset"
    done
done
EOF
}

run_sessions_fzf() {
    local query="$1"
    local preview_cmd
    preview_cmd="$(session_preview_cmd)"

    local selection_output
    selection_output="$(tmux list-sessions -F "#{session_name}" 2>/dev/null | fzf \
        --tmux=center,80%,80% \
        --ansi \
        --border=rounded \
        --color=separator:30 \
        --print-query \
        --expect=ctrl-n \
        --prompt="Sessions> " \
        --header="enter:switch  ctrl-x:kill session  ctrl-n:projects" \
        --bind='ctrl-x:execute-silent(tmux kill-session -t {} 2>/dev/null)+reload(tmux list-sessions -F "#{session_name}" 2>/dev/null)' \
        --preview="$preview_cmd" \
        --preview-window="right,50%,border-left,wrap" \
        --query="$query")" || return 1

    printf '%s' "$selection_output"
}

run_projects_fzf() {
    local query="$1"
    local selection_output

    selection_output="$(zoxide query --list --score --exclude "$PWD" 2>/dev/null | fzf \
        --tmux=center,80%,80% \
        --ansi \
        --no-sort \
        --border=rounded \
        --color=separator:30 \
        --print-query \
        --expect=ctrl-n \
        --prompt="Projects> " \
        --header="enter:create/switch  ctrl-n:sessions" \
        --preview='eza --all --group-directories-first --color=always --icons --oneline --level=2 --tree -- {2..}' \
        --preview-window="up" \
        --query="$query")" || return 1

    printf '%s' "$selection_output"
}

switch_to_session() {
    local session="$1"
    if [[ -z "$session" ]]; then
        return 0
    fi

    # "=" forces exact session-name matching: tmux otherwise accepts unique
    # prefixes, so -t api could silently target api-dev
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "=$session"
    else
        tmux attach -t "=$session"
    fi
}

switch_to_project() {
    local selection="$1"
    local dir session

    # zoxide prints "<score> <path>"; keep the remainder intact so paths
    # with spaces survive
    IFS=' ' read -r _ dir <<< "$selection"
    if [[ -z "$dir" ]]; then
        return 0
    fi

    dir="${dir#./}"
    session="$(basename "$dir")"
    # colons are illegal in tmux -t targets (parsed as session:window)
    session="${session//:/_}"
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -c "$dir"
    fi

    switch_to_session "$session"
}

run_picker() {
    local mode="$1"
    local query="$2"
    local selection_output
    local -a lines

    while true; do
        case "$mode" in
            sessions)
                selection_output="$(run_sessions_fzf "$query")" || return 0
                ;;
            projects)
                selection_output="$(run_projects_fzf "$query")" || return 0
                ;;
            *)
                return 1
                ;;
        esac

        lines=("${(@f)selection_output}")
        query="${lines[1]:-}"
        local key="${lines[2]:-}"
        local selection="${lines[3]:-}"

        if [[ "$key" == "ctrl-n" ]]; then
            mode="$([[ "$mode" == sessions ]] && echo projects || echo sessions)"
            continue
        fi

        [[ -z "$selection" ]] && return 0

        if [[ "$mode" == sessions ]]; then
            switch_to_session "$selection"
        else
            switch_to_project "$selection"
        fi
        return 0
    done
}

main() {
    local mode="sessions"
    local -a query_parts

    while (( $# > 0 )); do
        case "$1" in
            -h|--help)
                show_help
                return 0
                ;;
            --mode)
                shift
                mode="${1:-}"
                (( $# )) && shift
                ;;
            --mode=*)
                mode="${1#--mode=}"
                shift
                ;;
            *)
                query_parts+=("$1")
                shift
                ;;
        esac
    done

    case "$mode" in
        ""|sessions) mode="sessions" ;;
        projects) ;;
        *)
            echo "Unknown --mode: $mode (expected sessions or projects)"
            return 1
            ;;
    esac

    local cmd
    for cmd in tmux fzf zoxide eza; do
        command -v "$cmd" >/dev/null 2>&1 || {
            echo "tmux-switcher: missing dependency: $cmd" >&2
            return 1
        }
    done

    ensure_server || return 1

    run_picker "$mode" "${(j: :)query_parts}"
}

main "$@"
