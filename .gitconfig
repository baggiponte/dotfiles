# This is Git per-user configuration file.
[user]
	name = baggiponte
	email = 57922983+baggiponte@users.noreply.github.com
	signingkey = /Users/baggiponte/.ssh/git-signing-ed25519

[github]
  user = baggiponte
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true

[core]
  excludesFile = ~/.config/.gitignore.global

[diff]
  colorMoved = default
  submodule = log

[lfs "customtransfer.xet"]
	path = git-xet
	args = transfer
	concurrent = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[credential]
	# reset helpers inherited from the Homebrew system config, then use the Keychain
	helper =
	helper = osxkeychain
[credential "https://github.com"]
	username = baggiponte

[includeIf "gitdir:~/work/"]
	path = ~/work/.gitconfig
[gpg]
	format = ssh
[commit]
	gpgsign = true
